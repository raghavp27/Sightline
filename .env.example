# Copy to .env (never commit .env). Mock mode needs no key.
# Vision: PERCEPTRON_MODE=mock (default), perceptron or live (real Perceptron, needs the key). See below.
PERCEPTRON_MODE=mock
PERCEPTRON_API_KEY=
# Vision modes: mock (default, fake detections) | perceptron (full client: places, localization,
# reference photos; see docs/VISION.md) | live (fast detect-only client for guidance: one call per frame,
# 2 s timeout, errors mean "not seen", frames dropped while one is in flight).
# Model id. perceptron-mk1.5 for mode "perceptron"; mode "live" falls back to perceptron-mk1 (the one id
# Perceptron's docs confirm) when blank. Other ids are unconfirmed for your key: check with the probe script.
PERCEPTRON_MODEL=perceptron-mk1.5
# mode "perceptron": seconds before a call fails (provider failures are HTTP 503).
PERCEPTRON_TIMEOUT_SECONDS=15
VISION_FRAME_MAX_PX=640
# Optional JSON manifest of cropped item reference photos (see docs/VISION.md).
PERCEPTRON_REFERENCES=
# mode "live": seconds before a call counts as "not seen". Blank = 2.
PERCEPTRON_TIMEOUT_S=
# Max /api/guide frames per second each phone sends (tune after measuring latency; 0.5 to 10).
GUIDE_MAX_FPS=3
FOV_H_DEGREES=65
DB_PATH=sightline.db
# Folder for the small item thumbnails (never full frames). Blank = ./thumbs next to where the backend runs.
THUMBS_DIR=

# Conversational layer (POST /api/chat). mock = keyword matching, no network, no keys.
# LLM_PROVIDER: mock | purple | gemini | openai_compat
# Preference order: purple -> gemini -> keyword. The chain starts at LLM_PROVIDER and falls through
# the later ones on any error, 3 s timeout or missing key, always ending at keyword matching.
#   LLM_PROVIDER=purple  tries purple, then gemini, then keyword
#   LLM_PROVIDER=gemini  tries gemini, then keyword
# Only the user's words, the last 6 turns, and item/alias/room names are ever sent to a provider.
LLM_PROVIDER=mock
# Purple (nebulaONE): needs API access. List model ids with: python -m app.llm models
PURPLE_API_BASE=https://purple.uw.edu/api/external/v1
PURPLE_API_TOKEN=
PURPLE_MODEL=
# Google Gemini via its OpenAI-compatible endpoint. Key from Google AI Studio.
# Blank GEMINI_BASE_URL = https://generativelanguage.googleapis.com/v1beta/openai (from Google's docs).
# Model names change; list what your key can use with: python -m app.llm models
# Measured on 2026-10-17 (short chat requests): gemini-3.5-flash-lite ~0.5-0.9 s and correct;
# gemini-3.8-flash ~2-3 s (too slow for the 3 s timeout) and 429 under load; 2.5 models returned 404.
#   GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=
# Any OpenAI-compatible server (stand-in until Purple access works)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Seconds before a language-model call falls back to the next provider. Blank = 3.
LLM_TIMEOUT_S=

# Speech-to-text for the phone page. browser = the phone's built-in recognition (no keys).
# elevenlabs = the phone records a short WAV and the backend relays it to ElevenLabs
# (the audio leaves your machine to ElevenLabs only; it is never stored or logged).
# If ElevenLabs fails or the key is missing, the phone falls back to browser recognition.
STT_PROVIDER=browser
ELEVENLABS_API_KEY=
# Blank = scribe_v2 (the model id in ElevenLabs' docs; check them, names change)
ELEVENLABS_STT_MODEL=
ELEVENLABS_BASE_URL=
# Seconds before a speech-to-text upload fails (the phone then falls back). Blank = 10.
STT_TIMEOUT_S=

# Text-to-speech: how the phone speaks chat replies. browser = the phone's built-in voice (no keys).
# elevenlabs = the reply text goes to ElevenLabs and the phone plays the mp3 in your chosen voice.
# Needs ELEVENLABS_API_KEY (above) and ELEVENLABS_VOICE_ID. If ElevenLabs fails or takes too long
# (3 s on the server, 2.5 s on the phone) the phone speaks with its built-in voice instead.
TTS_PROVIDER=browser
# Voice id from your ElevenLabs account (Voices / My Voices).
ELEVENLABS_VOICE_ID=
# Blank = eleven_flash_v2_5 (low latency; used by kaustubh-branch but NOT shown on ElevenLabs' convert page,
# which documents eleven_multilingual_v2). Model names change: set this if the default is rejected.
ELEVENLABS_TTS_MODEL=
# Guidance cues ("Wallet at 2 o'clock", "Reach out now"):
#   always = the ElevenLabs voice for every cue, so you hear ONE voice (default). A brand-new cue takes about
#            0.7 s, a repeat about 0.2 s (short phrases are cached); the phone falls back to its own voice
#            only if ElevenLabs fails or is too slow.
#   cached = ElevenLabs only for audio the server already has (the fixed cues "Reach out now", "Stopped.",
#            "Lost it. Turn slowly left." are pre-rendered at startup); every other cue is the phone's voice.
#   never  = guidance always uses the phone's own voice.
TTS_GUIDANCE=always
# Seconds before a text-to-speech request fails (the phone then uses its own voice). Blank = 3.
TTS_TIMEOUT_S=

# "Hey Jarvis" wake word for the phone apps (opt-in: the app streams the microphone to YOUR backend while open).
# Needs the optional packages and models first (see README): pip install -r backend/requirements-wake.txt, then
# python -m audio_directions.setup_wake. Also needs STT_PROVIDER=elevenlabs.
WAKE_ENABLED=false
# Score from 0 to 1 needed to count as a wake (higher = fewer false wakes, more misses).
WAKE_THRESHOLD=0.6
# Blank = audio_directions/models/pretrained
WAKE_MODEL_DIR=
